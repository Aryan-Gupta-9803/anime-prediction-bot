DISCORD_TOKEN=

# The bot is locked to one server. Enable Developer Mode in Discord, right-click your server
# icon, Copy Server ID. Commands also sync to just this server, so they show up instantly.
GUILD_ID=

# A PRIVATE channel only hosts can see. The bot posts a backup file here after changes, and a
# fresh install restores from the newest one. Right-click the channel, Copy Channel ID.
BACKUP_CHANNEL_ID=

# Role (besides anyone with Manage Server) allowed to run host commands.
ADMIN_ROLE_NAME=Event Host

# Where the database file lives. Optional; defaults to ./data. If your host has a persistent
# folder or volume, point this at it. If not, don't worry: the backup channel restores it.
# DATA_DIR=data

# The bot sends a DM when it starts, every 24 hours, and when it shuts down cleanly, so you notice if it dies (no
# message for a day = it's down). It goes to whoever owns the bot's Discord application; set ALERT_USER_ID to send
# it to someone else, or HEARTBEAT_DM=off to turn it off. You must allow DMs from server members for it to arrive.
# ALERT_USER_ID=
# HEARTBEAT_DM=on

# How many automatic backups to keep in the channel (manual, pre-reset and pre-restore ones are never pruned).
# BACKUP_KEEP=50

# An automatic backup is posted at most this often, and only if something changed. Scoring a week, ending
# the season, /reset, /restore and /backup always post one regardless. 1 = a daily safety net.
# BACKUP_EVERY_DAYS=7
